{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "claude-dash desktop app",
  "main": "dist/main.cjs",
  "scripts": {
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/main.cjs",
    "dev": "npm run bundle && electron .",
    "build": "npm run bundle && electron-builder --mac",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "dev.claude-dash.app",
    "productName": "claude-dash",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "claude-dash-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "claude-dash controls Terminal to bring the tab of a Claude Code session to the front."
      }
    }
  }
}
